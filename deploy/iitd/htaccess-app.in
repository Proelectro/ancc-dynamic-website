# Generated by deploy/iitd/deploy.sh; edits here are overwritten on the next deploy.
Options -Indexes
DirectoryIndex index.html
@AUTH@
RewriteEngine On
RewriteBase @BASE@/

# API calls go to the PHP app (api.php loads the code from outside the web root).
RewriteRule ^api/ api.php [L,QSA]

# Single-page app: any path that isn't a real file is handled by index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
    # Built assets have content hashes in their names, so they can be cached for a year.
    <FilesMatch "\.(js|css|svg|png|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>
