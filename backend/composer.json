{
    "name": "ancc-iitd/website-backend",
    "description": "ANCC (Algorithm and Coding Club, IIT Delhi) website API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": { "Ancc\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src bin public tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
    },
    "config": {
        "sort-packages": true
    }
}
